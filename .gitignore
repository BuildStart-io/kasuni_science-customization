# Environment variables (do not commit secrets)
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
!**/.env.example
!**/.env.*.example

# Docker persistent volumes & runtime data
docker/volumes/
docker/volumes/**

# Dependencies & Build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.cache/

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
cloudflared.log

# IDE & OS metadata
.DS_Store
Thumbs.db
.gemini/
.agents/
.vscode/
.idea/

# Deployment & sensitive scripts
deploy*.sh
*.sh
*_filled.sql
*create_superadmin*.sql

